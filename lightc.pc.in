prefix=@PREFIX@
includedir=${prefix}/include
libdir=${prefix}/lib
ldscript_tiny=${libdir}/lightc/lightc-tiny.ld

Name: lightc
Description: Freestanding C runtime for Linux
Version: 0.1.0
Cflags: -I${includedir} -ffreestanding -fno-stack-protector @ARCH_CFLAGS@
Libs: -static -nostdlib -nostartfiles -L${libdir} -T${libdir}/lightc/lightc.ld -llightc
